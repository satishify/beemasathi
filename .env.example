# Hosted OpenAI-compatible model (leave blank to use local Ollama)
BEEMASATHI_LLM_BASE=
BEEMASATHI_LLM_KEY=
BEEMASATHI_LLM_MODEL=Qwen/Qwen3-8B
BEEMASATHI_LLM_CA=
BEEMASATHI_LLM_MAX_TOKENS=1024
BEEMASATHI_LLM_CONTEXT=8192

# Hosted embedding endpoint (same bge-small-en-v1.5 vectors as the index).
# Leave the base blank to embed locally with sentence-transformers.
# Use KEY_FILE for a file-based key, or KEY for an inline value.
BEEMASATHI_EMBED_BASE=
BEEMASATHI_EMBED_KEY=
BEEMASATHI_EMBED_KEY_FILE=
BEEMASATHI_EMBED_MODEL=bge-small-en-v1.5
BEEMASATHI_EMBED_CA=
BEEMASATHI_EMBED_BATCH=16

# Request tracing to logs/traces (1 on, 0 off)
BEEMASATHI_TRACE=1
