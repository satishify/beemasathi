erDiagram
    KNOWLEDGE_SOURCE ||--o{ POLICY_DOCUMENT : publishes
    KNOWLEDGE_SOURCE ||--o{ CATALOG_ENTRY : summarized_as
    POLICY_DOCUMENT ||--o| DOCUMENT_SIDECAR : described_by
    POLICY_DOCUMENT ||--o{ POLICY_CHUNK : split_into
    POLICY_DOCUMENT ||--o| INGEST_INDEX_ROW : tracked_by
    POLICY_CHUNK }o--|| CATALOG_ENTRY : rolls_up_to
    POLICY_CHUNK }o--o{ GENERATED_ANSWER : retrieved_for
    QUERY ||--o| GENERATED_ANSWER : produces
    QUERY }o--o| KNOWLEDGE_SOURCE : filters
    CLAIM_CASE ||--o| CLAIM_ASSESSMENT : scored_as
    CLAIM_CASE }o--o| KNOWLEDGE_SOURCE : about
    GOLD_CASE ||--o| EVAL_RESULT : judged_as
    GOLD_CASE }o--o| POLICY_DOCUMENT : validated_against
    SCRAPE_RUN ||--o{ DISCOVERY_CANDIDATE : finds
    DISCOVERY_CANDIDATE }o--o| POLICY_DOCUMENT : may_download

    KNOWLEDGE_SOURCE {
        string key PK
        string name
        string base_url
        string kind
    }

    POLICY_DOCUMENT {
        string path PK
        string insurer FK
        string policy_name
        string document_type
        string line_of_business
        string source_url
        string sha256
        int size_bytes
    }

    DOCUMENT_SIDECAR {
        string path PK
        string insurer
        string policy_name
        string document_type
        string line_of_business
        string source_url
        string uin
    }

    POLICY_CHUNK {
        string id PK
        string source
        string insurer
        string policy_name
        string section
        string chunk_type
        int page
        string document_type
        string line_of_business
        string text
        float distance
    }

    CATALOG_ENTRY {
        string insurer
        string policy_name
        string document_type
        string source_file
        int chunks
    }

    INGEST_INDEX_ROW {
        string file PK
        string sha256
        string insurer
        string policy_name
        string document_type
        int chunks
        datetime indexed_at
    }

    QUERY {
        string question
        string insurer
        string policy_name
        string mode
    }

    GENERATED_ANSWER {
        string answer
        bool safe
        json sources
        json model_metrics
        string rejection_risk
    }

    CLAIM_CASE {
        string insurer
        string policy_name
        string hospital_name
        bool is_network_hospital
        bool has_ped
        int months_since_policy
        float room_rent_per_day
        float sum_insured
    }

    CLAIM_ASSESSMENT {
        int risk_score
        list failed_checks
        list passed_checks
        string summary
    }

    GOLD_CASE {
        string id PK
        string category
        string question
        string gold_notes
        list must_include_any
        bool expect_refuse
        bool expect_block
    }

    EVAL_RESULT {
        string case_id FK
        bool passed
        json rules
        json judge_scores
        string answer
    }

    SCRAPE_RUN {
        datetime finished_at
        list selected_insurers
        string mode
        int downloaded
    }

    DISCOVERY_CANDIDATE {
        string url
        string insurer
        string line
        string doc_type
        string policy
        string uin
        bool stale_marker
    }
